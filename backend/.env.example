# Copier ce fichier en .env et remplir les valeurs

# URL de connexion PostgreSQL
# Format: postgresql://utilisateur:motdepasse@hote:port/nom_base
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@HOTE:6543/postgres?sslmode=require

# Autoriser les origines CORS (frontend Vue.js en dev)
CORS_ORIGINS=http://localhost:5173

# Clé de signature des JWT — obligatoire, aléatoire, >= 32 caractères
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Documentation Swagger (/docs) : à activer seulement en local
EXPOSER_DOCS=false

# Brevo — envoi d'e-mails transactionnels (mot de passe oublié)
# Créer un compte sur brevo.com, vérifier l'adresse expéditrice, puis générer une clé API
EMAIL_API_KEY=
EMAIL_EXPEDITEUR=
EMAIL_EXPEDITEUR_NOM=EduClé
