# Copier ce fichier en .env et remplir les valeurs

# URL de connexion PostgreSQL
# Format: postgresql://utilisateur:motdepasse@hote:port/nom_base
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@HOTE:6543/postgres?sslmode=require

# Autoriser les origines CORS (frontend Vue.js en dev)
CORS_ORIGINS=http://localhost:5173

# Clé de signature des JWT — obligatoire, aléatoire, >= 32 caractères
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Documentation Swagger (/docs) : à activer seulement en local
EXPOSER_DOCS=false

# Brevo — envoi d'e-mails transactionnels (mot de passe oublié)
# Créer un compte sur brevo.com, vérifier l'adresse expéditrice, puis générer une clé API
EMAIL_API_KEY=
EMAIL_EXPEDITEUR=
EMAIL_EXPEDITEUR_NOM=EduClé

# Web Push VAPID — générer avec :
# python -c "from cryptography.hazmat.primitives.asymmetric import ec; from cryptography.hazmat.primitives import serialization; import base64; k=ec.generate_private_key(ec.SECP256R1()); priv=k.private_numbers().private_value.to_bytes(32,'big'); pub=k.public_key().public_bytes(serialization.Encoding.X962,serialization.PublicFormat.UncompressedPoint); print('PRIV:',base64.urlsafe_b64encode(priv).rstrip(b'=').decode()); print('PUB:',base64.urlsafe_b64encode(pub).rstrip(b'=').decode())"
# La clé publique va aussi dans VITE_VAPID_PUBLIC_KEY côté Netlify
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@educle.app
# Secret partagé entre GitHub Actions (secret CRON_SECRET) et le backend
CRON_SECRET=
